version: '3.8'
services:
  db:
    image: postgres:15
    container_name: clinica_db
    environment:
      POSTGRES_DB: clinica_db
      POSTGRES_USER: admin
      POSTGRES_PASSWORD: admin123
    ports:
      - '5432:5432'
    volumes:
      - postgres_data:/var/lib/postgresql/data
    restart: always

volumes:
  postgres_data:

