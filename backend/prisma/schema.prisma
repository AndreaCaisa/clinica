generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Paciente {
  id            Int      @id @default(autoincrement())
  cedula        String   @unique
  nombre        String
  apellido      String
  fechaNacimiento DateTime
  telefono      String?
  direccion     String?
  email         String?
  createdAt     DateTime @default(now())
  historias     HistoriaClinica[]
  facturas      Factura[]
}

model Medico {
  id         Int      @id @default(autoincrement())
  cedula     String   @unique
  nombre     String
  apellido   String
  especialidad String
  telefono   String?
  email      String?
  consultas  Consulta[]
  hospitalizaciones Hospitalizacion[]
  usuarioId  Int?     @unique
  usuario    UsuarioSistema? @relation(fields: [usuarioId], references: [id])
}

model HistoriaClinica {
  id         Int      @id @default(autoincrement())
  pacienteId Int
  fecha      DateTime @default(now())
  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  triajes    Triaje[]
  consultas  Consulta[]
}

model Triaje {
  id              Int      @id @default(autoincrement())
  historiaId      Int
  fecha           DateTime @default(now())
  presionArterial String?
  temperatura     Float?
  peso            Float?
  talla           Float?
  frecuenciaCardiaca Int?
  historia        HistoriaClinica @relation(fields: [historiaId], references: [id])
}

model Consulta {
  id          Int      @id @default(autoincrement())
  historiaId  Int
  medicoId    Int
  fecha       DateTime @default(now())
  motivo      String
  diagnostico String?
  tratamiento String?
  historia    HistoriaClinica @relation(fields: [historiaId], references: [id])
  medico      Medico @relation(fields: [medicoId], references: [id])
  recetas     Receta[]
}

model Receta {
  id         Int      @id @default(autoincrement())
  consultaId Int
  fecha      DateTime @default(now())
  consulta   Consulta @relation(fields: [consultaId], references: [id])
  detalles   DetalleReceta[]
}

model DetalleReceta {
  id         Int    @id @default(autoincrement())
  recetaId   Int
  medicamento String
  dosis      String
  frecuencia String
  duracion   String
  receta     Receta @relation(fields: [recetaId], references: [id])
}

model Insumo {
  id         Int    @id @default(autoincrement())
  nombre     String
  descripcion String?
  stock      Int    @default(0)
  precio     Float
  consumos   ConsumoHospitalario[]
}

model Habitacion {
  id         Int    @id @default(autoincrement())
  numero     String @unique
  tipo       String
  disponible Boolean @default(true)
  hospitalizaciones Hospitalizacion[]
}

model Hospitalizacion {
  id           Int      @id @default(autoincrement())
  pacienteId   Int? 
  medicoId     Int
  habitacionId Int
  fechaIngreso DateTime @default(now())
  fechaAlta    DateTime?
  motivo       String
  medico       Medico @relation(fields: [medicoId], references: [id])
  habitacion   Habitacion @relation(fields: [habitacionId], references: [id])
  consumos     ConsumoHospitalario[]
}

model ConsumoHospitalario {
  id                Int   @id @default(autoincrement())
  hospitalizacionId Int
  insumoId          Int
  cantidad          Int
  fecha             DateTime @default(now())
  hospitalizacion   Hospitalizacion @relation(fields: [hospitalizacionId], references: [id])
  insumo            Insumo @relation(fields: [insumoId], references: [id])
}

model Factura {
  id         Int      @id @default(autoincrement())
  pacienteId Int
  fecha      DateTime @default(now())
  total      Float
  pagada     Boolean  @default(false)
  paciente   Paciente @relation(fields: [pacienteId], references: [id])
  detalles   DetalleFactura[]
}

model DetalleFactura {
  id          Int    @id @default(autoincrement())
  facturaId   Int
  descripcion String
  cantidad    Int
  precioUnitario Float
  subtotal    Float
  factura     Factura @relation(fields: [facturaId], references: [id])
}

model UsuarioSistema {
  id         Int      @id @default(autoincrement())
  username   String   @unique
  password   String
  rol        String
  activo     Boolean  @default(true)
  createdAt  DateTime @default(now())
  logs       LogAuditoria[]
  medico     Medico?
}

model LogAuditoria {
  id         Int      @id @default(autoincrement())
  usuarioId  Int
  accion     String
  tabla      String
  fecha      DateTime @default(now())
  usuario    UsuarioSistema @relation(fields: [usuarioId], references: [id])
}


